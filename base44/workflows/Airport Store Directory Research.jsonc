{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "airport_store_directory_research",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "research_next_batch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "researchAirportStores",
            "args": {
              "batch_size": 6
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Research next airports",
            "description": "6 airports per run"
          }
        }
      }
    ]
  },
  "name": "Airport Store Directory Research",
  "description": "Works through the airport directory in batches, recording the real shops listed on each airport's own website. Stops automatically once the full list has been covered.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-09-22T18:20:00Z",
      "ends_type": "after_count",
      "ends_on_date": null,
      "ends_after_count": 200
    }
  }
}