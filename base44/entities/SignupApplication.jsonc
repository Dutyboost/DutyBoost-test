{
  "name": "SignupApplication",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "business_type": {
      "type": "string",
      "title": "Business Type",
      "enum": [
        "Travel Agency",
        "Airport Retailer"
      ]
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "kvk": {
      "type": "string",
      "title": "KVK Number"
    },
    "vat": {
      "type": "string",
      "title": "VAT Number"
    },
    "booking_system": {
      "type": "string",
      "title": "Booking System"
    },
    "airport": {
      "type": "string",
      "title": "Airport"
    },
    "store_category": {
      "type": "string",
      "title": "Store Category"
    },
    "travel_partners": {
      "type": "array",
      "title": "Corporate Travel Partners",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "invited",
        "rejected"
      ],
      "default": "pending"
    },
    "mollie_customer_id": {
      "type": "string",
      "title": "Mollie Customer ID"
    },
    "mollie_payment_id": {
      "type": "string",
      "title": "Mollie Payment ID"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method"
    },
    "bank_account_name": {
      "type": "string",
      "title": "Bank Account Holder Name"
    },
    "bank_iban": {
      "type": "string",
      "title": "Bank IBAN"
    },
    "terms_accepted": {
      "type": "boolean",
      "title": "Terms Accepted",
      "default": false
    }
  },
  "required": [
    "full_name",
    "email",
    "company",
    "business_type"
  ]
}