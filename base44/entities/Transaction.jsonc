{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "voucher_code": {
      "type": "string",
      "title": "Voucher Code"
    },
    "retailer_id": {
      "type": "string",
      "title": "Retailer ID"
    },
    "store_name": {
      "type": "string",
      "title": "Store Name"
    },
    "transaction_value": {
      "type": "number",
      "title": "Transaction Value (EUR)"
    },
    "num_items": {
      "type": "integer",
      "title": "Number of Items Scanned"
    },
    "discount_applied": {
      "type": "number",
      "title": "Effective Discount Applied (%)"
    },
    "base_discount": {
      "type": "number",
      "title": "Base Discount Percentage (%)"
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount Amount (EUR)"
    },
    "platform_revenue": {
      "type": "number",
      "title": "Platform Revenue / DutyBoost Fee (EUR)"
    },
    "agency_commission": {
      "type": "number",
      "title": "Agency Commission (EUR)"
    },
    "agency_email": {
      "type": "string",
      "title": "Agency Email"
    },
    "airport": {
      "type": "string",
      "title": "Airport"
    }
  },
  "required": [
    "voucher_code",
    "retailer_id",
    "store_name",
    "transaction_value",
    "discount_applied",
    "platform_revenue"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.agency_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}