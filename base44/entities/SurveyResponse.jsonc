    },
    "company_website": {
      "type": "string",
      "title": "Company Website"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "company_type": {
      "type": "string",
      "title": "Company Type"
    },
    "annual_bookings": {
      "type": "string",
      "title": "Annual Bookings / Monthly Visitors Volume"
    },
    "current_loyalty": {
      "type": "string",
      "title": "Current loyalty program"
    },
    "interest_level": {
      "type": "string",
      "title": "Interest level in DutyBoost"
    },
    "commission_attractive": {
      "type": "string",
      "title": "Commission model attractiveness"
    },
    "snippet_willingness": {
