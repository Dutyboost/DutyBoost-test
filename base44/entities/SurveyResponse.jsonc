{
  "name": "SurveyResponse",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "company_website": {
      "type": "string",
      "title": "Company Website"
    },
    "pos_provider": {
      "type": "string",
      "title": "Point-of-Sale Provider"
    },
    "travel_platform": {
      "type": "string",
      "title": "Travel / Expense Platform"
    },
    "retailers_served": {
      "type": "array",
      "title": "Airport Retailers Served",
      "items": {
        "type": "string"
      }
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "company_type": {
      "type": "string",
      "title": "Company Type"
    },
    "annual_bookings": {
      "type": "string",
      "title": "Annual Bookings / Monthly Visitors Volume"
    },
    "non_purchase_percentage": {
      "type": "string",
      "title": "Estimated % of Travellers Leaving Without Purchase"
    },
    "pre_activation_value": {
      "type": "string",
      "title": "Value of Pre-Airport Traveller Activation"
    },
    "pay_after_channel_interest": {
      "type": "string",
      "title": "Interest in Pay-After-Verified-Transaction Channel"
    },
    "current_loyalty": {
      "type": "string",
      "title": "Current loyalty program"
    },
    "interest_level": {
      "type": "string",
      "title": "Interest level in DutyBoost"
    },
    "commission_attractive": {
      "type": "string",
      "title": "Commission model attractiveness"
    },
    "snippet_willingness": {
      "type": "string",
      "title": "Willingness to implement DutyBoost snippet"
    },
    "biggest_challenge": {
      "type": "string",
      "title": "Biggest challenge with customer loyalty"
    },
    "wants_demo": {
      "type": "boolean",
      "title": "Wants a demo call",
      "default": false
    }
  },
  "required": [
    "company_name",
    "company_type",
    "interest_level"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}