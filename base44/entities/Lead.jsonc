{
  "name": "Lead",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "industry": {
      "type": "string",
      "title": "Industry",
      "enum": [
        "Retail",
        "Agency",
        "POS Channel Partner"
      ]
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "position": {
      "type": "string",
      "title": "Position within the Company"
    },
    "decision_level": {
      "type": "string",
      "title": "Decision Making Level",
      "enum": [
        "Executive",
        "Manager",
        "Staff"
      ]
    }
  },
  "required": [
    "company_name",
    "website",
    "industry",
    "email",
    "phone",
    "full_name"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}