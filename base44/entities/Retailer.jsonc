{
  "name": "Retailer",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string",
      "title": "Store Name"
    },
    "airport": {
      "type": "string",
      "title": "Airport Location"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Retail"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "accepts_vouchers": {
      "type": "boolean",
      "title": "Accepts Vouchers",
      "default": true
    },
    "owner_email": {
      "type": "string",
      "title": "Owner Email"
    },
    "pos_channel_partner": {
      "type": "string",
      "title": "POS Channel Partner"
    },
    "pos_channel_commission_rate": {
      "type": "number",
      "title": "POS Channel Commission Rate (%)",
      "default": 10
    }
  },
  "required": [
    "store_name",
    "airport",
    "category"
  ]
}