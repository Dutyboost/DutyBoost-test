{
  "name": "LetterOfIntent",
  "type": "object",
  "properties": {
    "partner_company_name": {
      "type": "string",
      "title": "Partner Company Name"
    },
    "partner_street": {
      "type": "string",
      "title": "Partner Street + Number"
    },
    "partner_postal_code": {
      "type": "string",
      "title": "Partner Postal Code"
    },
    "partner_city": {
      "type": "string",
      "title": "Partner City"
    },
    "partner_country": {
      "type": "string",
      "title": "Partner Country"
    },
    "partner_registration_number": {
      "type": "string",
      "title": "Chamber of Commerce Number"
    },
    "partner_vat": {
      "type": "string",
      "title": "Partner VAT/Tax Number"
    },
    "partner_representative_name": {
      "type": "string",
      "title": "Representative Full Name"
    },
    "partner_representative_title": {
      "type": "string",
      "title": "Representative Title"
    },
    "partner_website": {
      "type": "string",
      "title": "Partner Website"
    },
    "partner_email": {
      "type": "string",
      "title": "Partner Email"
    },
    "partner_type": {
      "type": "string",
      "title": "Partner Type",
      "enum": [
        "Travel Agency",
        "Airline",
        "Accommodation",
        "Car Rental",
        "Tour Operator",
        "OTA",
        "Other"
      ]
    },
    "signed": {
      "type": "boolean",
      "title": "Accepted & Signed",
      "default": false
    },
    "signed_date": {
      "type": "string",
      "title": "Signed Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "reviewed",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "partner_company_name",
    "partner_street",
    "partner_postal_code",
    "partner_city",
    "partner_country",
    "partner_registration_number",
    "partner_vat",
    "partner_representative_name",
    "partner_email",
    "signed"
  ]
}