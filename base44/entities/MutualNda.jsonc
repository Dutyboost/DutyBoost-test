{
  "name": "MutualNda",
  "type": "object",
  "properties": {
    "party_company_name": {
      "type": "string",
      "title": "Counterparty Company Name"
    },
    "party_street": {
      "type": "string",
      "title": "Street + Number"
    },
    "party_postal_code": {
      "type": "string",
      "title": "Postal Code"
    },
    "party_city": {
      "type": "string",
      "title": "City"
    },
    "party_country": {
      "type": "string",
      "title": "Country"
    },
    "party_registration_number": {
      "type": "string",
      "title": "Chamber of Commerce / Registration Number"
    },
    "party_representative_name": {
      "type": "string",
      "title": "Representative Full Name"
    },
    "party_representative_title": {
      "type": "string",
      "title": "Representative Title"
    },
    "party_email": {
      "type": "string",
      "title": "Representative Email"
    },
    "party_website": {
      "type": "string",
      "title": "Company Website"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose of the Discussions"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "title": "Effective Date"
    },
    "signed": {
      "type": "boolean",
      "title": "Accepted & Signed",
      "default": false
    },
    "signed_date": {
      "type": "string",
      "title": "Signed Date"
    },
    "signature_file_uri": {
      "type": "string",
      "title": "Signature File (private)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "reviewed",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    },
    "language": {
      "type": "string",
      "title": "Language",
      "default": "en"
    }
  },
  "required": [
    "party_company_name",
    "party_country",
    "party_representative_name",
    "party_email",
    "signed"
  ]
}