        "Travel Partner"
      ]
    },
    "reason": {
      "type": "string",
      "title": "Deletion Reason"
    },
    "other_reason": {
      "type": "string",
      "title": "Other Reason (free text)"
    }
  },
  "required": [
    "email",
    "user_type",
    "reason"
  ]
}